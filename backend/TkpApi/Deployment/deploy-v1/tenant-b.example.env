COMPOSE_PROJECT_NAME=tkp-tenant-b
API_IMAGE=tkp-api:ops-001-local
POSTGRES_IMAGE=postgres:17-bookworm
TKP_DB_NAME=tkp_b
TKP_DB_USER=tkp_b_app
API_PORT=5086
API_CPUS=1.0
API_MEMORY_LIMIT=512m
API_PIDS_LIMIT=256
DB_CPUS=1.0
DB_MEMORY_LIMIT=1g
DB_PIDS_LIMIT=256
TENANT_HOST=tenant-b.example.test
TENANT_ORIGIN=https://tenant-b.example.test
JWT_ISSUER=tkp-tenant-b
JWT_AUDIENCE=tkp-web-tenant-b
DB_BOOTSTRAP_PASSWORD_FILE=/srv/tkp/tenant-b/secrets/db-bootstrap
DB_APP_PASSWORD_FILE=/srv/tkp/tenant-b/secrets/db-app
JWT_KEY_FILE=/srv/tkp/tenant-b/secrets/jwt
ADMIN_EMAIL=admin@tenant-b.example.test
ADMIN_PASSWORD_FILE=/srv/tkp/tenant-b/secrets/admin

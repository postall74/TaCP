COMPOSE_PROJECT_NAME=tkp-tenant-a
API_IMAGE=tkp-api:ops-001-local
POSTGRES_IMAGE=postgres:17-bookworm
TKP_DB_NAME=tkp_a
TKP_DB_USER=tkp_a_app
API_PORT=5085
TENANT_HOST=tenant-a.example.test
TENANT_ORIGIN=https://tenant-a.example.test
JWT_ISSUER=tkp-tenant-a
JWT_AUDIENCE=tkp-web-tenant-a
DB_BOOTSTRAP_PASSWORD_FILE=/srv/tkp/tenant-a/secrets/db-bootstrap
DB_APP_PASSWORD_FILE=/srv/tkp/tenant-a/secrets/db-app
JWT_KEY_FILE=/srv/tkp/tenant-a/secrets/jwt
ADMIN_EMAIL=admin@tenant-a.example.test
ADMIN_PASSWORD_FILE=/srv/tkp/tenant-a/secrets/admin
